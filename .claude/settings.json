{
  "permissions": {
    "allow": [
      "Bash(git :*)",
      "Bash(fvm :*)",
      "Bash(flutter :*)",
      "Bash(dart :*)",
      "Bash(php :*)",
      "Bash(composer :*)",
      "Bash(python3 tools/*)",
      "Bash(python3 delphi-ai/*)",
      "Bash(bash tools/*)",
      "Bash(bash delphi-ai/*)",
      "Bash(cat :*)",
      "Bash(ls :*)",
      "Bash(find :*)",
      "Bash(grep :*)",
      "Bash(head :*)",
      "Bash(tail :*)",
      "Bash(wc :*)",
      "Bash(diff :*)",
      "Bash(mkdir :*)",
      "Bash(docker :*)",
      "Bash(docker-compose :*)",
      "Read(*)",
      "Write(foundation_documentation/**)",
      "Write(flutter-app/**)",
      "Write(laravel-app/**)",
      "Write(docker/**)",
      "Write(docker-compose.yml)"
    ],
    "deny": []
  },
  "model": "claude-sonnet-4-6",
  "availableModels": [
    "sonnet",
    "opus",
    "haiku"
  ],
  "enforceAvailableModels": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session_start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre_tool_use.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/post_tool_use.sh"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "project_settings",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/config_change.sh"
          }
        ]
      }
    ]
  }
}
