#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || pwd)"

if [[ -f "$REPO_ROOT/main_instructions.md" && -d "$REPO_ROOT/tools" ]]; then
  DELPHI_ROOT="$REPO_ROOT"
elif [[ -f "$REPO_ROOT/delphi-ai/main_instructions.md" && -d "$REPO_ROOT/delphi-ai/tools" ]]; then
  DELPHI_ROOT="$REPO_ROOT/delphi-ai"
else
  printf '%s\n' '{"cancel":false,"contextModification":"Delphi session-start hook could not resolve delphi-ai. Manually load main_instructions.md and the profile-selection workflow before editing."}'
  exit 0
fi

python3 "$DELPHI_ROOT/tools/session_hook_guard.py" --client cline-ide --event TaskStart --repo-root "$REPO_ROOT"
